{
  "permissions": {
    "allow": [
      "Bash(claude-notify*)",
      "Bash(file:*)",
      "Bash(brew install:*)",
      "Bash(Rscript:*)",
      "Bash(python3:*)",
      "Bash(find /Users/and502/.claude -name \"*installed*\" -o -name \"*registry*\" -o -name \"*state*\" 2>/dev/null | grep -i plugin)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "//dev/ttys*",
        "//dev/pts/*"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
